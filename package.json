{
  "name": "fiscaliza-varginha",
  "version": "1.0.0",
  "private": true,
  "description": "Painel Cidadão de Fiscalização — Varginha-MG",
  "scripts": {
    "data:schedule:daily": "powershell -ExecutionPolicy Bypass -File scripts/install-data-task.ps1 -Mode Daily -At 06:30 -TaskName \"Fiscaliza Varginha - Atualizacao diaria\"",
    "data:schedule:watch": "powershell -ExecutionPolicy Bypass -File scripts/install-data-task.ps1 -Mode Watch -IntervalMinutes 180 -OnlyIfChanged -SkipTests -SkipPackage -SkipDeploy -TaskName \"Fiscaliza Varginha - Vigia de dados\"",
    "data:schedule:financial": "powershell -ExecutionPolicy Bypass -File scripts/install-financial-task.ps1 -At 05:15",
    "data:audit": "node scripts/audit-data-quality.mjs",
    "data:bundle": "node scripts/sync-data-bundle.mjs",
    "data:chat": "node scripts/generate-chat-context.mjs",
    "data:indice": "node scripts/generate-indice-relevancia.mjs",
    "data:monitor": "node scripts/generate-collection-monitor.mjs",
    "data:saude": "node scripts/check-pipeline-health.mjs",
    "data:schema": "python painel-cidadao/validar_schemas_dados.py",
    "data:probe": "node scripts/check-source-updates.mjs --no-exit-code",
    "data:snapshot": "node scripts/generate-data-snapshots.mjs",
    "data:update": "powershell -ExecutionPolicy Bypass -File scripts/update-data.ps1",
    "data:update:financial": "powershell -ExecutionPolicy Bypass -File scripts/update-financial-data.ps1",
    "data:update:watch": "powershell -ExecutionPolicy Bypass -File scripts/update-data.ps1 -OnlyIfChanged -SkipTests -SkipPackage -SkipDeploy",
    "backup:external": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-external.ps1",
    "test:lock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-lock-estado.ps1",
    "test:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-atomic-restore.ps1",
    "test:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-external-backup.ps1",
    "health:external": "node scripts/check-external-site.mjs",
    "report:daily": "node scripts/generate-daily-operational-report.mjs",
    "data:values": "python scripts/backfill-publication-values.py",
    "data:pages": "python scripts/backfill-publication-pages.py",
    "deploy:zip": "powershell -ExecutionPolicy Bypass -File scripts/package-deploy.ps1",
    "lint:syntax": "node scripts/check-syntax.mjs",
    "lint:accents": "node scripts/check-accents.mjs",
    "lint:seo": "node scripts/check-seo.mjs",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "performance:site": "node scripts/check-site-performance.mjs",
    "release": "npm run test:lock && npm run test:security && npm run data:indice && npm run data:monitor && npm run data:chat && npm run data:bundle && npm run lint:syntax && npm run lint:accents && npm run lint:seo && npm run performance:budget && npm run validate:data && npm test && npm run deploy:zip && npm run validate:deploy",
    "test": "playwright test",
    "test:data": "node scripts/check-syntax.mjs && npm run test:security && node tests/test_editorial_assertions.mjs && playwright test tests/calculos.spec.js",
    "test:pipeline": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:security": "node tests/test_chat_xss.mjs && node tests/test_chat_proxy_contract.mjs",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "validate:data": "npm run data:schema && npm run data:audit && npm run data:snapshot && npm run data:chat && npm run data:bundle && npm run test:numeros && node scripts/validate-release.mjs data",
    "validate:deploy": "node scripts/validate-release.mjs deploy",
    "test:numeros": "node tests/test_numeros_publicados.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  },
  "dependencies": {
    "playwright": "^1.58.2"
  }
}
